# Copy to `.env` and adjust as needed. docker compose reads this file automatically.

# Postgres (used by the postgres service and to build DATABASE_URL)
POSTGRES_USER=vibeops
POSTGRES_PASSWORD=vibeops
POSTGRES_DB=vibeops
POSTGRES_PORT=5432

# Host port mappings
API_PORT=5000
WEB_PORT=4173

# Used when running tools/scripts on the host (e.g. `pnpm --filter @workspace/db run push`).
# Inside containers DATABASE_URL is set to point at the `postgres` service.
DATABASE_URL=postgres://vibeops:vibeops@localhost:5432/vibeops
